# Database
DATABASE_URL=postgresql+asyncpg://legal:legal_dev@localhost:5433/legal_research
# Sync URL for alembic
DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev@localhost:5433/legal_research
# psycopg3 DSN for LangGraph checkpointer
CHECKPOINTER_DSN=postgresql://legal:legal_dev@localhost:5433/legal_research?options=-csearch_path%3Dlanggraph

# LLM
# LLM_PROVIDER selects the research-phase provider (planner/search/
# evaluator/extractor/gap_check) — "openai" (default if unset) or
# "anthropic". GENERATION_LLM_PROVIDER independently selects the
# Generation-phase provider (thesis/outline/draft/voice); leave unset
# to fall back to LLM_PROVIDER, or set it separately to mix providers —
# e.g. research on OpenAI, generation on Anthropic, as below.
LLM_PROVIDER=openai
GENERATION_LLM_PROVIDER=anthropic

# OpenAI — required whenever LLM_PROVIDER=openai (the default) or
# GENERATION_LLM_PROVIDER=openai. OPENAI_MODEL is used for every call
# made through this provider, in whichever phase selects it — there is
# no separate per-node (planner/extractor/draft/voice) model setting.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Anthropic — required whenever either provider setting above is
# "anthropic". Same rule: CLAUDE_MODEL is the one model used for every
# call made through this provider.
ANTHROPIC_API_KEY=sk-ant-...
# Only needed for identity-linked API keys (the API returns a 400 asking
# for `anthropic-workspace-id` if yours is one). Leave empty otherwise.
ANTHROPIC_WORKSPACE_ID=
CLAUDE_MODEL=claude-sonnet-5

# Search providers
TAVILY_API_KEY=tvly-...
PERPLEXITY_API_KEY=pplx-...

# Future providers — uncomment when ready
# EXA_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# INDIANKANOON_API_TOKEN=

# Budget defaults
DEFAULT_BUDGET_INR=120.00

# Logging
LOG_LEVEL=INFO
DEBUG_PAYLOADS=false
