# Database
DATABASE_URL=postgresql+asyncpg://legal:legal_dev@localhost:5432/legal_research
# Sync URL for alembic
DATABASE_URL_SYNC=postgresql+psycopg://legal:legal_dev@localhost:5432/legal_research
# psycopg3 DSN for LangGraph checkpointer
CHECKPOINTER_DSN=postgresql://legal:legal_dev@localhost:5432/legal_research?options=-csearch_path%3Dlanggraph

# LLM
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_PLANNER_MODEL=claude-sonnet-4-20250514
CLAUDE_EXTRACTOR_MODEL=claude-sonnet-4-20250514

# Search providers
TAVILY_API_KEY=tvly-...
PERPLEXITY_API_KEY=pplx-...

# Future providers — uncomment when ready
# EXA_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
# INDIANKANOON_API_TOKEN=

# Budget defaults
DEFAULT_BUDGET_INR=120.00

# Logging
LOG_LEVEL=INFO
DEBUG_PAYLOADS=false
